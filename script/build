#!/usr/bin/env bash
set -ex

rm -rf src-tauri/target/release/bundle

if [ -z "$CI" ]; then
  ./script/prepare-env
fi

# `unwrap_used` and `expect_used` are warnings in Cargo.toml so editors still
# show them, but they are allowed here until the remaining uses are removed.
# Drop the two `-A` flags (and make the lints `deny` in Cargo.toml) after that.
(
  cd src-tauri
  cargo clippy -- \
    -D warnings \
    -A clippy::unwrap_used \
    -A clippy::expect_used
)

./node_modules/.bin/vite build
./node_modules/.bin/tauri build

# Macos .app bundes don't have the arch specified in the filename.
if [ "$(uname -s)" = Darwin ]; then
  TAURI_ARCH="x86_64"
  if [[ $(sysctl -n machdep.cpu.brand_string) = Apple* ]]; then
    TAURI_ARCH="aarch64"
  fi

  for f in src-tauri/target/release/bundle/macos/*.app; do
    mv "${f}" "${f/.app/-${TAURI_ARCH}.app}"
  done

  for f in src-tauri/target/release/bundle/macos/*.app.tar.gz; do
    mv "${f}" "${f/.app.tar.gz/-${TAURI_ARCH}.app.tar.gz}"
  done

  for f in src-tauri/target/release/bundle/macos/*.app.tar.gz.sig; do
    mv "${f}" "${f/.app.tar.gz.sig/-${TAURI_ARCH}.app.tar.gz.sig}"
  done
fi
